
{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "roborio-party-website",

  "compatibility_date": "2026-10-26",

  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "../out",
    "not_found_handling": "404-page"
  },

  "env": {
    "production": {
      "name": "roborio-party-website-production",

      "workers_dev": false,
      "preview_urls": false,

      "routes": [
        {
          "pattern": "finallynomoreroborio.party",
          "custom_domain": true
        },
        {
          "pattern": "www.finallynomoreroborio.party",
          "custom_domain": true
        }
      ],

      "assets": {
        "directory": "../out",
        "not_found_handling": "404-page"
      }
    }
  }
}
