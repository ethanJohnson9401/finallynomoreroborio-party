
{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "roborio-trauma-admin-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",

  "workers_dev": false,

  "observability": {
    "enabled": true
  },

  "vars": {
    "ADMIN_API_ENABLED": "true",
    "ADMIN_QUEUE_ENABLED": "true"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roborio-trauma-db",
      "database_id": "276e3d2b-dee8-40b0-a5b0-585231effff3",
      "migrations_dir": "migrations"
    }
  ],

  "env": {
    "production": {
      "name": "roborio-trauma-admin-api-production",

      "workers_dev": false,

      "routes": [
        {
          "pattern": "admin-api.finallynomoreroborio.party",
          "custom_domain": true
        }
      ],

      "vars": {
        "ADMIN_API_ENABLED": "true",
        "ADMIN_QUEUE_ENABLED": "true"
      },

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "roborio-trauma-db",
          "database_id": "276e3d2b-dee8-40b0-a5b0-585231effff3",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
