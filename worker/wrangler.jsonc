
/**
 * finallynomoreroborio.party
 * Cloudflare Worker configuration
 *
 * Default environment: local development
 * Production environment: explicitly configured,
 * with incident submissions disabled.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",

	"name": "roborio-trauma-api",

	"main": "src/index.ts",

	"compatibility_date": "2026-10-19",

	"observability": {
		"enabled": true
	},

	"upload_source_maps": true,

	/**
	 * Default environment configuration.
	 *
	 * Local secrets are loaded from .dev.vars.
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "roborio-trauma-db",
			"database_id": "276e3d2b-dee8-40b0-a5b0-585231effff3",
			"migrations_dir": "migrations"
		}
	],

	"ratelimits": [
		{
			"name": "INCIDENT_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],

	/**
	 * Production environment.
	 *
	 * Does not enable submissions until we
	 * explicitly change this configuration.
	 */
	"env": {
		"production": {
			"name": "roborio-trauma-api-production",

			"vars": {
				"DEPLOYMENT_ENV": "production",
				"ENABLE_INCIDENT_SUBMISSIONS": "false",
				"TURNSTILE_TEST_MODE": "false"
			},

			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "roborio-trauma-db",
					"database_id": "276e3d2b-dee8-40b0-a5b0-585231effff3",
					"migrations_dir": "migrations"
				}
			],

			"ratelimits": [
				{
					"name": "INCIDENT_LIMITER",
					"namespace_id": "1002",
					"simple": {
						"limit": 5,
						"period": 60
					}
				}
			]
		}
	}
}
