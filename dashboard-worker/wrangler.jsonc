
{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "roborio-trauma-dashboard",

  "main": "src/index.ts",

  "compatibility_date": "2026-10-25",

  "workers_dev": false,

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "../admin-dashboard/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "env": {
    "production": {
      "name": "roborio-trauma-dashboard-production",

      "workers_dev": false,

      "routes": [
        {
          "pattern": "admin.finallynomoreroborio.party",
          "custom_domain": true
        }
      ],

      "assets": {
        "directory": "../admin-dashboard/out",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "run_worker_first": ["/api/*"]
      }
    }
  }
}
